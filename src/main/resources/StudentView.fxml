<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.cesul.studentregistry.view.StudentListView">
   <children>
      <BorderPane prefHeight="600.0" prefWidth="600.0">
         <top>
            <VBox prefHeight="77.0" prefWidth="600.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="56.0" prefWidth="600.0">
                     <children>
                        <Label prefHeight="17.0" prefWidth="49.0" text="Nome: " />
                        <TextField fx:id="txtName" prefHeight="25.0" prefWidth="136.0" />
                        <Label text="email:">
                           <padding>
                              <Insets left="10.0" right="10.0" />
                           </padding>
                        </Label>
                        <TextField fx:id="txtEmail" prefHeight="23.0" prefWidth="155.0">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                        </TextField>
                        <Label text="Nota:">
                           <padding>
                              <Insets left="10.0" right="10.0" />
                           </padding>
                        </Label>
                        <Spinner fx:id="spnGrade" />
                     </children>
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                  </HBox>
                  <HBox prefHeight="62.0" prefWidth="600.0">
                     <children>
                        <Button mnemonicParsing="false" prefHeight="17.0" prefWidth="74.0" text="Adicionar" onAction="#onAdd">
                           <padding>
                              <Insets right="10.0" />
                           </padding>
                           <HBox.margin>
                              <Insets left="10.0" right="10.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="btnToggle" mnemonicParsing="false" prefHeight="17.0" prefWidth="99.0" text="Alternar Ativo" onAction="#onToggle">
                           <padding>
                              <Insets left="10.0" />
                           </padding>
                           <HBox.margin>
                              <Insets left="10.0" right="10.0" />
                           </HBox.margin>
                        </Button>
                        <Button fx:id="btnUpdate" alignment="CENTER" mnemonicParsing="false" prefHeight="17.0" prefWidth="104.0" text="Atualizar Nota" onAction="#onUpdate">
                           <padding>
                              <Insets left="10.0" />
                           </padding>
                           <HBox.margin>
                              <Insets left="10.0" right="10.0" />
                           </HBox.margin>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </top>
         <center>
            <TableView fx:id="table" prefHeight="336.0" prefWidth="580.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="colName" prefWidth="132.3333282470703" text="nome" />
                <TableColumn fx:id="colEmail" prefWidth="148.6666717529297" text="email" />
                  <TableColumn fx:id="colGrade" prefWidth="166.66665649414062" text="nota" />
                  <TableColumn fx:id="colActive" prefWidth="129.33331298828125" text="ativo" />
              </columns>
               <BorderPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </center>
         <bottom>
            <HBox prefHeight="61.0" prefWidth="600.0" BorderPane.alignment="CENTER">
               <children>
                  <ProgressIndicator fx:id="progress" progress="0.0" visible="false" />
                  <Label fx:id="lblError" text="Label">
                     <padding>
                        <Insets left="20.0" top="10.0" />
                     </padding>
                  </Label>
               </children>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
